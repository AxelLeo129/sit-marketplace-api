APP_NAME="SIT Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://sit-marketplace-api.test

APP_TIMEZONE=America/Guatemala
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Contraseñas con Argon2id. HASH_VERIFY=false permite verificar las que aún estén en
# bcrypt; al iniciar sesión se vuelven a cifrar con Argon2id automáticamente.
HASH_DRIVER=argon2id
HASH_VERIFY=false
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sit_marketplace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" en local (los correos quedan en storage/logs). En producción "resend" con RESEND_API_KEY.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Administrador inicial (php artisan db:seed)
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Reglas de negocio (porcentajes)
MARKETPLACE_VAT_RATE=12
MARKETPLACE_CARD_FEE_RATE=2.5

# Seguridad de la API
SANCTUM_TOKEN_EXPIRATION=720
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Bloqueo de cuenta: intentos fallidos, minutos del primer bloqueo y tope (se duplica en cada bloqueo).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_LOCKOUT_MAX_MINUTES=1440
# Rechazar contraseñas filtradas (consulta anónima a Have I Been Pwned).
CHECK_BREACHED_PASSWORDS=true
# Días que se guardan los eventos de autenticación.
AUTH_EVENTS_RETENTION_DAYS=365
# IPs de los proxies de confianza (separadas por coma) o "*" detrás de un balanceador.
# Vacío en local: no se confía en X-Forwarded-For.
TRUSTED_PROXIES=

# Imágenes: "public" en local (requiere php artisan storage:link) o "firebase".
MEDIA_DISK=public

# Cloud Storage for Firebase (solo con MEDIA_DISK=firebase). Ver README.
FIREBASE_PROJECT_ID=sit-marketplace
FIREBASE_STORAGE_BUCKET=sit-marketplace.firebasestorage.app
# Ruta al JSON de la cuenta de servicio; por defecto storage/app/private/firebase-credentials.json
FIREBASE_CREDENTIALS=storage/app/private/firebase-credentials.json
# En servidores sin archivos propios (Railway): el contenido del JSON en una línea. Tiene prioridad.
FIREBASE_CREDENTIALS_JSON=
