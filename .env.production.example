# Variables de producción para Railway (servicio "api" y servicio "scheduler").
# Se pegan en Railway → servicio → Variables → Raw Editor. Este archivo es solo una
# plantilla: los valores reales (claves, contraseñas) nunca se versionan.
# ${{MySQL.MYSQL_URL}} es una referencia de Railway al servicio de base de datos.

APP_NAME="SIT Marketplace"
APP_ENV=production
# php artisan key:generate --show (una sola vez; no cambiarla: cifra los datos clínicos)
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.tu-dominio.com
APP_TIMEZONE=America/Guatemala
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

HASH_DRIVER=argon2id
HASH_VERIFY=false

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_URL=${{MySQL.MYSQL_URL}}

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Correo con Resend (por HTTPS; Railway bloquea SMTP en el plan Hobby).
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="no-reply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Administrador inicial: php artisan db:seed --force (se puede borrar después)
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

MARKETPLACE_VAT_RATE=12
MARKETPLACE_CARD_FEE_RATE=2.5

SANCTUM_TOKEN_EXPIRATION=720
CORS_ALLOWED_ORIGINS=https://app.tu-dominio.com
FRONTEND_URL=https://app.tu-dominio.com
CHECK_BREACHED_PASSWORDS=true
# Railway pone su proxy delante y la app no es accesible de otra forma.
TRUSTED_PROXIES=*

MEDIA_DISK=firebase
FIREBASE_PROJECT_ID=sit-marketplace
FIREBASE_STORAGE_BUCKET=sit-marketplace.firebasestorage.app
# Contenido completo del JSON de la cuenta de servicio, en una sola línea.
FIREBASE_CREDENTIALS_JSON=
